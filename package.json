{
  "name": "claude-video-editing-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hand-drawn AI video editing motion animation recreated with Remotion, React, and SVG",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "start": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts ClaudeVideoEditingMotion out/claude-video-editing-motion.mp4 --codec=h264 --crf=18",
    "still": "remotion still src/index.ts ClaudeVideoEditingMotion out/preview.png --frame=880"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
